        SELECT id, channel_link, channel_id, channel_title, last_forwarded_msg_id,
               total_files_found, total_files_forwarded
        FROM t2t_channels
        WHERE status = 'done'
          AND completed_at IS NOT NULL
          AND completed_at < %s
        ORDER BY completed_at ASC LIMIT 1
